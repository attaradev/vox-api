aws_region  = "us-east-1"
project     = "vox"
environment = "staging"

availability_zones = ["us-east-1a", "us-east-1b"]

# Optionally override with a prebuilt image; otherwise the provisioned ECR repo is used
container_image = ""

alb_allowed_cidrs = ["0.0.0.0/0"]

# Merge with defaults defined in variables.tf
ecs_task_environment = {
  DJANGO_SETTINGS_MODULE = "vox_api.settings.production"
  ALLOWED_HOSTS          = "app.example.com"
}

stripe_secret_key = "SK_REDACTED"
frontend_url      = "https://app.example.com"

# Example overrides for data tiers
db_instance_class  = "db.t4g.small"
db_allocated_storage = 50
redis_node_type      = "cache.t4g.small"

# Alarm destinations (SNS topic ARNs, etc.)
alarm_actions = []

# Leave false in production to protect data
s3_force_destroy = false
