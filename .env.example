# Django
# DJANGO_SECRET_KEY: Secret key for Django (change in production!)
DJANGO_SECRET_KEY=dev-secret-change-me
# DJANGO_ENV: Set to 'development' for local/dev, 'production' for deployment
DJANGO_ENV=development
# DJANGO_ALLOWED_HOSTS: Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=*

# Postgres
POSTGRES_DB=vox
POSTGRES_USER=vox
POSTGRES_PASSWORD=voxpass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django DB URL (used in settings)
# Used for direct DB connections (optional)
DATABASE_URL=postgresql+psycopg://vox:voxpass@db:5432/vox

# Email (for Django email backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Celery/Redis (for background jobs)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# FRONTEND_URL: Used for password reset links in emails
FRONTEND_URL=https://your-frontend
