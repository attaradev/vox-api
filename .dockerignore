# Ignore Python cache and artifacts
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments
*.env
*.venv
env/
venv/
ENV/

# Ignore editor and OS files
.vscode/
.idea/
.DS_Store

# Ignore test and coverage files
*.log
htmlcov/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# Ignore database files
*.db
*.sqlite3
*.sqlite

# Ignore Django static and media
static/
media/

# Ignore migrations
vox_api/**/migrations/
vox_api/**/migrations/*.py
vox_api/**/migrations/*.pyc

# Ignore config and secrets
.env*
secrets.*

# Ignore infrastructure files and artifacts
infra/
infra/terraform/
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfplan
infra/terraform/terraform.tfvars
infra/terraform/variables.tf
infra/terraform/main.tf.backup
infra/terraform/modules/**/.terraform/
infra/terraform/modules/**/.terraform.lock.hcl
infra/terraform/modules/**/terraform.tfstate*
infra/terraform/modules/**/terraform.tfvars
infra/terraform/modules/**/main.tf.backup
infra/terraform/modules/**/.DS_Store
infra/terraform/modules/**/.idea/
infra/terraform/modules/**/.vscode/
infra/**/*.log
infra/**/*.tmp
infra/**/*.bak
infra/**/*.swp
infra/**/*.swo
infra/**/build/
infra/**/dist/
